# Application Setup
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# PostgreSQL Database Connections (Replace with your PostgreSQL connection strings in .env.local)
DATABASE_URL="postgresql://user:password@localhost:5432/little_lambs_db?schema=public&sslmode=prefer"
DIRECT_URL="postgresql://user:password@localhost:5432/little_lambs_db?schema=public"

# Auth.js / NextAuth Session Secret (Generate via `openssl rand -base64 32`)
AUTH_SECRET="replace-with-generated-secret"
AUTH_URL="http://localhost:3000"

# Server-Side Private Merchant UPI Configuration (NEVER EXPOSE TO CLIENT BUNDLE)
UPI_VPA="replace-with-merchant-vpa"
UPI_PAYEE_NAME="replace-with-payee-name"

# Cron Security Secret (Used for authenticating /api/cron/expire-reservations)
CRON_SECRET="replace-with-random-secret"

# Configurable Shipping Strategy (Development non-production defaults)
DEV_SHIPPING_FLAT_RATE="40"
DEV_SHIPPING_FREE_THRESHOLD="300"
