// Prisma Schema for Little Lambs E-Commerce Platform
// Engine: PostgreSQL (Synced with live database schema)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String               @id @default(uuid())
  email               String               @unique
  passwordHash        String
  fullName            String
  phone               String?
  role                Role                 @default(CUSTOMER)
  isEmailVerified     Boolean              @default(false)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  addresses           Address[]
  auditLogs           AuditLog[]
  cart                Cart?
  orders              Order[]
  passwordResetTokens PasswordResetToken[]
  stockMovements      StockMovement[]
}

model Book {
  id               String          @id @default(uuid())
  title            String
  subtitle         String?
  slug             String          @unique
  sku              String          @unique
  isbn             String          @unique
  description      String
  shortDescription String?
  ageMin           Int
  ageMax           Int
  language         String
  publisher        String
  edition          String?
  releaseDate      DateTime?
  stock            Int             @default(0)
  reservedStock    Int             @default(0)
  status           BookStatus      @default(DRAFT)
  featured         Boolean         @default(false)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  pricePaise       Int             @default(10000)
  images           BookImage[]
  cartItems        CartItem[]
  orderItems       OrderItem[]
  stockMovements   StockMovement[]

  @@index([featured, status])
  @@index([status, title])
}

model BookImage {
  id         String    @id @default(uuid())
  bookId     String
  imageUrl   String
  storageKey String
  altText    String
  sortOrder  Int       @default(0)
  type       ImageType @default(COVER_FRONT)
  createdAt  DateTime  @default(now())
  book       Book      @relation(fields: [bookId], references: [id], onDelete: Cascade)
}

model Address {
  id           String   @id @default(uuid())
  userId       String
  phone        String
  addressLine1 String
  addressLine2 String?
  city         String
  district     String?
  state        String
  postalCode   String
  landmark     String?
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  country      String   @default("India")
  fullName     String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Cart {
  id        String     @id @default(uuid())
  userId    String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
}

model CartItem {
  id        String   @id @default(uuid())
  cartId    String
  bookId    String
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)

  @@unique([cartId, bookId])
}

model Order {
  id                   String                @id @default(uuid())
  orderNumber          String                @unique
  userId               String
  paymentStatus        PaymentStatus         @default(PENDING)
  fulfilmentStatus     FulfilmentStatus      @default(AWAITING_PAYMENT)
  customerNotes        String?
  reservationExpiresAt DateTime?
  placedAt             DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  shippingCarrier      String?
  trackingNumber       String?
  shippedAt            DateTime?
  deliveredAt          DateTime?
  deliveryMethod       DeliveryMethod?
  shippingPaise        Int
  subtotalPaise        Int
  totalPaise           Int
  user                 User                  @relation(fields: [userId], references: [id])
  addressSnapshot      OrderAddressSnapshot?
  items                OrderItem[]
  payments             Payment[]

  @@index([fulfilmentStatus, placedAt])
  @@index([userId, paymentStatus, placedAt])
}

model OrderItem {
  id             String @id @default(uuid())
  orderId        String
  bookId         String
  titleSnapshot  String
  skuSnapshot    String
  quantity       Int
  lineTotalPaise Int
  unitPricePaise Int
  book           Book   @relation(fields: [bookId], references: [id])
  order          Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model OrderAddressSnapshot {
  id           String  @id @default(uuid())
  orderId      String  @unique
  phone        String
  addressLine1 String
  addressLine2 String?
  city         String
  district     String?
  state        String
  postalCode   String
  landmark     String?
  country      String  @default("India")
  fullName     String
  order        Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Payment {
  id                   String        @id @default(uuid())
  orderId              String
  method               PaymentMethod @default(UPI_MANUAL)
  utrReference         String?       @unique
  screenshotUrl        String?
  screenshotStorageKey String?
  status               PaymentStatus @default(PENDING)
  verifiedByUserId     String?
  rejectionReason      String?
  adminNote            String?
  submittedAt          DateTime?
  verifiedAt           DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  expectedAmountPaise  Int
  order                Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, status])
}

model AuditLog {
  id          String   @id @default(uuid())
  actorUserId String?
  action      String
  entityType  String
  entityId    String?
  payload     Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())
  actor       User?    @relation(fields: [actorUserId], references: [id])
}

model StockMovement {
  id            String            @id @default(uuid())
  bookId        String
  type          StockMovementType
  quantityDelta Int
  previousStock Int
  newStock      Int
  reason        String
  actorUserId   String?
  createdAt     DateTime          @default(now())
  actor         User?             @relation(fields: [actorUserId], references: [id])
  book          Book              @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([bookId, createdAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  usedAt    DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum Role {
  CUSTOMER
  ADMIN
}

enum BookStatus {
  DRAFT
  COMING_SOON
  ACTIVE
  OUT_OF_STOCK
  ARCHIVED
}

enum ImageType {
  COVER_FRONT
  COVER_BACK
  PREVIEW
  PROMOTIONAL
}

enum PaymentMethod {
  UPI_MANUAL
}

enum PaymentStatus {
  PENDING
  VERIFICATION_PENDING
  PAID
  REJECTED
  REFUNDED
}

enum FulfilmentStatus {
  AWAITING_PAYMENT
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum StockMovementType {
  INITIAL
  RESTOCK
  CORRECTION
  ORDER_CONFIRMED
  RETURN
  OTHER
}

enum DeliveryMethod {
  DTDC
  LOCAL_DELIVERY
}

